<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:MSG00.Translation.UI.ViewModels"
			 xmlns:models="using:MSG00.Translation.UI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:ConversationCsvbViewModel"
             x:Class="MSG00.Translation.UI.Views.ConversationCsvbView">
	<Grid RowDefinitions="*, auto">
		<ScrollViewer Grid.Row="0">
			<ItemsControl ItemsSource="{Binding Rows, Mode=OneWay}" Margin="12">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical" Spacing="6"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.DataTemplates>
					<DataTemplate DataType="models:ConversationSpeakerRow">
						<TextBlock Text="{Binding Label}" Margin="{Binding Indent}" FontWeight="SemiBold" Padding="0,8,0,0"/>
					</DataTemplate>
					<DataTemplate DataType="models:ConversationMarkerRow">
						<TextBlock Text="{Binding Label}" Margin="{Binding Indent}" Foreground="SteelBlue" FontStyle="Italic"/>
					</DataTemplate>
					<DataTemplate DataType="models:ConversationTextEntry">
						<StackPanel Orientation="Vertical" Spacing="2" Margin="{Binding Indent}">
							<TextBlock Text="{Binding Kind}" FontSize="11" Foreground="Gray"/>
							<TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" FontFamily="Consolas, Courier New, monospace" Foreground="Black" Width="420" HorizontalAlignment="Left"/>
							<TextBlock Text="{Binding Warning, Mode=OneWay}" Foreground="Red" IsVisible="{Binding HasWarning, Mode=OneWay}" TextWrapping="Wrap"/>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<Button Command="{Binding SplitCommand}" IsVisible="{Binding HasTooManyLines, Mode=OneWay}">Move lines 4+ to new box</Button>
								<Button Command="{Binding AddBoxCommand}">Add box after</Button>
								<Button Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}">Remove box</Button>
							</StackPanel>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.DataTemplates>
			</ItemsControl>
		</ScrollViewer>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
			<Button Command="{Binding ExportCommand}">Export</Button>
			<Button Command="{Binding ImportCommand}">Import</Button>
			<Button Command="{Binding SaveCommand}">Apply to ROM</Button>
		</StackPanel>
	</Grid>
</UserControl>