<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:models="using:MSG00.Translation.UI.Models"
			 xmlns:vm="using:MSG00.Translation.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:EvmCsvbViewModel"
             x:Class="MSG00.Translation.UI.Views.EvmCsvbView">
	<Grid RowDefinitions="*, auto">
		<TextBlock Grid.Row="0" Margin="12" TextWrapping="Wrap" IsVisible="{Binding HasNoMessages, Mode=OneTime}"
				   Text="This mission script has no messages to translate. Mission goals and results shown during the mission are cut-ins: see Cut-ins → Cut/CUTIN.fcmd (MES_* lines)."/>
		<ScrollViewer Grid.Row="0">
			<ItemsControl ItemsSource="{Binding Rows, Mode=OneWay}" Margin="12">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical" Spacing="8"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="models:EvmMessageRow">
						<StackPanel Orientation="Vertical" Spacing="2">
							<TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
							<TextBlock Text="{Binding Original}" Foreground="Gray" TextWrapping="Wrap"/>
							<TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" FontFamily="Consolas, Courier New, monospace" Foreground="Black" Width="420" HorizontalAlignment="Left"/>
							<TextBlock Text="{Binding Warning, Mode=OneWay}" Foreground="Red" IsVisible="{Binding HasWarning, Mode=OneWay}"/>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
			<Button Command="{Binding ExportCommand}">Export</Button>
			<Button Command="{Binding ImportCommand}">Import</Button>
			<Button Command="{Binding SaveCommand}">Apply to ROM</Button>
		</StackPanel>
	</Grid>
</UserControl>