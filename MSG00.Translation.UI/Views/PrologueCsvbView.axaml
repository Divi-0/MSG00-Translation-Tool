<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:models="using:MSG00.Translation.UI.Models"
			 xmlns:vm="using:MSG00.Translation.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:PrologueCsvbViewModel"
             x:Class="MSG00.Translation.UI.Views.PrologueCsvbView"
			 x:Name="prologueCsvbView">
	<Grid RowDefinitions="*, auto">

		<ScrollViewer
			Grid.Row="0"
			VerticalAlignment="Center"
			HorizontalAlignment="Stretch">
			<ItemsControl
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			ItemsSource="{Binding Entries, Mode=OneWay}"
			IsVisible="{Binding IsFileLoaded, Mode=OneWay}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical" Spacing="12"></StackPanel>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="models:PrologueTextEntry">
						<StackPanel Orientation="Vertical" Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" FontFamily="Consolas, Courier New, monospace" Foreground="Black" Width="420"/>
								<StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Top" IsVisible="{Binding HasDuration, Mode=OneWay}">
									<TextBlock Text="Last image (frames)"/>
									<NumericUpDown Value="{Binding Duration, Mode=TwoWay}" Minimum="1" Maximum="65535" Increment="30" FormatString="0" Width="150"/>
									<TextBlock Text="{Binding OnScreenText, Mode=OneWay}"/>
									<Button Command="{Binding ApplySuggestedDurationCommand}" IsVisible="{Binding IsDurationTooShort, Mode=OneWay}">Use suggested</Button>
								</StackPanel>
							</StackPanel>
							<TextBlock Text="{Binding DurationHint, Mode=OneWay}" Foreground="DarkOrange" IsVisible="{Binding IsDurationTooShort, Mode=OneWay}" TextWrapping="Wrap"/>
							<TextBlock Text="{Binding LineWarning, Mode=OneWay}" Foreground="Red" IsVisible="{Binding HasLineWarning, Mode=OneWay}" TextWrapping="Wrap"/>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
			<Button Command="{Binding ExportCommand}" HorizontalAlignment="Center">Export</Button>
			<Button Command="{Binding ImportCommand}" HorizontalAlignment="Center">Import</Button>
			<Button Command="{Binding SaveCommand}" HorizontalAlignment="Center">Apply to ROM</Button>
		</StackPanel>
	</Grid>
</UserControl>
